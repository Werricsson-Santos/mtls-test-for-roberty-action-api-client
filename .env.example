PORT=8443

# OAuth2 client_credentials test client
CLIENT_ID=test-client-id
CLIENT_SECRET=test-client-secret

TOKEN_TTL_SECONDS=3600

# false (default): TLS handshake succeeds even without a valid client cert;
#   the API then checks the certificate itself and returns a JSON 401 "access denied".
#   Friendlier for testing with curl/Postman.
# true: Node rejects the TLS handshake outright when the client certificate
#   is missing/invalid (closer to a production mTLS setup).
STRICT_MTLS=false

TLS_KEY_PATH=certs/server.key
TLS_CERT_PATH=certs/server.crt
TLS_CA_PATH=certs/ca.crt
